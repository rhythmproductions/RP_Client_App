# Copy this file to .env.local and fill in your own values.

# Password used to access the /admin (uploads) and /portal (approvals)
# pages. Keep this secret.
ADMIN_PASSWORD=change-me-please

# Optional shared code that gates the /upload page so only people you give
# the code to can send you files. Leave unset to keep uploads open.
UPLOAD_ACCESS_CODE=456

# Google Drive — required for file storage.
# 1. Create a service account in Google Cloud Console with Drive API enabled.
# 2. Download its JSON key and paste the entire JSON as one line below.
#    Tip: the private_key field's "\n" sequences are fine as-is; the app
#    will normalise them back to real newlines.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com",...}

# 3. Create a Shared Drive (Workspace required), add the service account
#    above as a Manager, and paste the Shared Drive ID here. You can find
#    it in the URL: https://drive.google.com/drive/folders/<SHARED_DRIVE_ID>
GOOGLE_SHARED_DRIVE_ID=your-shared-drive-id-here

# Resend — for email notifications when clients upload.
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key-here

# ── Serving the app under your main site (optional) ───────────────────
# Only needed if you proxy this app behind another domain (e.g. serving
# /upload, /portal and /review/... from rhythmproductions.ca). Assets are
# proxied same-origin — see docs/serve-under-main-site.md.
#
# Set this to the PUBLIC domain visitors will use, so generated links
# (the shareable review link, dashboard links in emails) point at the apex
# domain instead of this app's own URL.
# NEXT_PUBLIC_REVIEW_BASE_URL=https://rhythmproductions.ca

# ── YouTube comment miner (optional tool) ─────────────────────────────
# Only needed if you use tools/youtube-comments to pull comments for
# marketing/copy research. Get a free key at console.cloud.google.com:
# create a project, enable "YouTube Data API v3", then
# APIs & Services → Credentials → Create credentials → API key.
# See tools/youtube-comments/README.md for the full walkthrough.
YOUTUBE_API_KEY=your-youtube-api-key-here
